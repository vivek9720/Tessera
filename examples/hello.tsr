# A short tour of Tessera, used by the README's example commands.

# Functions are first-class values and close over their environment.
func make_greeter(greeting) {
  return func(name) {
    return greeting ++ ", " ++ name ++ "!";
  };
}

let hello = make_greeter("Hello");
let hi = make_greeter("Hi");

println(hello("world"));
println(hi("Tessera"));

# Lists, maps, and the small standard library.
let nums = range(1, 6);
let total = 0;
let i = 0;
while (i < len(nums)) {
  total = total + nums[i];
  i = i + 1;
}
println("sum of 1..5 =", total);

let inventory = {"apples": 3, "pears": 5};
inventory["cherries"] = 12;
println("items:", len(keys(inventory)));

# Recursion.
func fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}
println("fib(10) =", fib(10));

return total;
